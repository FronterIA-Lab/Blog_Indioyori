{{!< default}}
{{!-- Plantilla: Talleres, libros y herramientas. Asígnala a tu página "Talleres". --}}

{{#post}}
<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / {{title}}</p>
    <div class="section-head">
      <span class="s-eyebrow">Formación</span>
      <h1 class="s-title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="s-desc">{{custom_excerpt}}</p>{{/if}}
    </div>

    {{#get "tiers" limit="all" as |tiers|}}
      {{#if tiers}}
      <div class="offer-grid" style="margin-bottom:2rem">
        {{#foreach tiers}}
          <article class="offer">
            <span class="offer-badge">Membresía</span>
            <h3>{{name}}</h3>
            {{#if description}}<p class="offer-desc">{{description}}</p>{{/if}}
            {{#if monthly_price}}<p class="offer-price">{{price monthly_price currency=currency}} <span>· al mes</span></p>{{/if}}
            {{#if yearly_price}}<p class="offer-meta">o {{price yearly_price currency=currency}} al año</p>{{/if}}
            <a class="btn btn-brand btn-full" href="#/portal/signup/{{id}}/monthly" data-portal="signup/{{id}}/monthly">Suscribirme</a>
          </article>
        {{/foreach}}
      </div>
      {{/if}}
    {{/get}}
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container prose">
    <div class="post-content">
      {{content}}
    </div>
  </div>
</section>
{{/post}}
