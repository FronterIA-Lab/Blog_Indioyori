{{!< default}}
{{!-- Plantilla: Talleres, libros y herramientas.
     Aquí van productos con Payment Links de Stripe en el contenido.
     El Círculo ($350/mes) vive en /membresia/ — no aquí. --}}

{{#post}}
<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / {{title}}</p>
    <div class="section-head">
      <span class="s-eyebrow">Formación · talleres · libros · cursos</span>
      <h1 class="s-title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="s-desc">{{custom_excerpt}}</p>{{/if}}
    </div>

    <div class="note" style="margin-bottom:1.5rem">
      Cada taller, libro o curso lleva su propio botón de pago (Stripe).
      El Círculo (espacio de trabajo · $350 MXN/mes) está en
      <a href="{{@site.url}}/membresia/"><b>Círculo</b></a>.
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container prose">
    <div class="post-content">
      {{content}}
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="callout">
      <h3>¿Inscripción grupal o a la medida?</h3>
      <p style="margin-top:0.5rem">Equipo, colectivo, aula, organización o institución: escríbeme con el contexto y armamos propuesta.</p>
      <div class="cta-row" style="margin-top:1rem">
        <a class="btn btn-brand" href="{{@site.url}}/contacto/">Solicitar propuesta grupal / institucional</a>
        <a class="btn" href="{{@site.url}}/membresia/">Ver el Círculo</a>
      </div>
    </div>
  </div>
</section>
{{/post}}
