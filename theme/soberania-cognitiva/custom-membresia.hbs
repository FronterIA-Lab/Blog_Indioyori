{{!< default}}
{{!-- Plantilla: Membresía.
     Tres capas: visitar (público) · cuenta gratis · círculo de pago.
     El pago no es obligatorio para que el sitio sea usable. --}}

{{#post}}
<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / {{title}}</p>
    <div class="section-head">
      <span class="s-eyebrow">Acceso · gratis funcional · pago opcional</span>
      <h1 class="s-title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="s-desc">{{custom_excerpt}}</p>{{/if}}
    </div>

    <div class="grid-3" style="margin-bottom:2rem">
      <div class="offer">
        <span class="offer-badge outline">Sin cuenta</span>
        <h3>Visitar</h3>
        <p class="offer-desc">Todo el conocimiento publicado es libre: notas, manifiesto, archivo, info de talleres y contacto.</p>
        <ul class="offer-bullets">
          <li>Leer sin registrarte</li>
          <li>Ver precios e inscripciones</li>
          <li>Escribir por Contacto</li>
        </ul>
      </div>
      <div class="offer">
        <span class="offer-badge soft">Cuenta gratis</span>
        <h3>Participar</h3>
        <p class="offer-desc">El sitio se vuelve comunidad: puedes comentar y entrar al chat general de Matrix.</p>
        <ul class="offer-bullets">
          <li>Comentar en publicaciones</li>
          <li>Chat general</li>
          <li>Boletín</li>
        </ul>
        {{#unless @member}}
          <a class="btn btn-full" style="margin-top:auto" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
        {{else}}
          <a class="btn btn-full" style="margin-top:auto" href="#/portal/account" data-portal="account">Mi cuenta</a>
        {{/unless}}
      </div>
      <div class="offer">
        <span class="offer-badge">Pago opcional</span>
        <h3>Círculo</h3>
        <p class="offer-desc">Lo mismo que la cuenta gratis, más una capa exclusiva: chat privado y recursos más sofisticados.</p>
        <ul class="offer-bullets">
          <li>Todo lo de cuenta gratis</li>
          <li>Chat exclusivo (Matrix)</li>
          <li>Materiales avanzados (RAG, datos, protocolos)</li>
        </ul>
      </div>
    </div>

    {{#get "tiers" include="monthly_price,yearly_price,currency" limit="all" as |tiers|}}
      {{#if tiers}}
      <div class="section-head">
        <span class="s-eyebrow">Suscripción</span>
        <h2 class="s-title">Elige cómo estar</h2>
      </div>
      <div class="offer-grid" style="margin-bottom:2rem">
        {{#foreach tiers}}
          <article class="offer">
            <span class="offer-badge">{{#if monthly_price}}Pago{{else}}Gratis{{/if}}</span>
            <h3>{{name}}</h3>
            {{#if description}}<p class="offer-desc">{{description}}</p>{{/if}}
            {{#if monthly_price}}
              <p class="offer-price">{{price monthly_price currency=currency}} <span>· al mes</span></p>
              {{#if yearly_price}}<p class="offer-meta">o {{price yearly_price currency=currency}} al año</p>{{/if}}
              {{#if @member.paid}}
                <a class="btn btn-brand btn-full" href="#/portal/account" data-portal="account">Ya estás en el círculo · Mi cuenta</a>
              {{else}}
                <a class="btn btn-brand btn-full" href="#/portal/signup/{{id}}/monthly" data-portal="signup/{{id}}/monthly">Entrar al círculo · {{price monthly_price currency=currency}}/mes</a>
              {{/if}}
            {{else}}
              <p class="offer-meta">Cuenta gratis · chat general + comentarios</p>
              {{#unless @member}}
                <a class="btn btn-full" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
              {{else}}
                <a class="btn btn-full" href="#/portal/account" data-portal="account">Mi cuenta</a>
              {{/unless}}
            {{/if}}
          </article>
        {{/foreach}}
      </div>
      {{else}}
      <div class="callout" style="margin-bottom:2rem">
        <h3>Configura los tiers en Ghost</h3>
        <p style="margin-top:0.5rem">Settings → Membership: deja un tier <b>Free</b> (cuenta gratis) y crea uno de pago (ej. <b>$500 MXN / mes</b>) conectado a Stripe. Los botones aparecen aquí solos.</p>
        <div class="cta-row" style="margin-top:1rem">
          <a class="btn btn-brand" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
        </div>
      </div>
      {{/if}}
    {{/get}}

    {{#if @member.paid}}
      {{#if @custom.matrix_paid_room_url}}
      <div class="section-head">
        <span class="s-eyebrow">Tu acceso exclusivo</span>
        <h2 class="s-title">Chat del círculo</h2>
      </div>
      <div class="chat" style="margin-bottom:2rem">
        <div class="chat-head"><span class="pulse" aria-hidden="true"></span><b>Chat exclusivo · miembros de pago</b></div>
        <iframe src="{{@custom.matrix_paid_room_url}}" allow="microphone; camera; autoplay; clipboard-write; encrypted-media" title="Chat exclusivo" loading="lazy"></iframe>
      </div>
      {{/if}}
    {{/if}}

    {{#if @custom.donate_url}}
    <div class="callout" style="margin-bottom:2rem">
      <h3>Donar</h3>
      <p style="margin-top:0.5rem">Si no quieres suscripción mensual pero sí sostener el trabajo, puedes donar lo que sea.</p>
      <div class="cta-row" style="margin-top:1rem">
        <a class="btn btn-brand" href="{{@custom.donate_url}}" target="_blank" rel="noopener">Donar</a>
      </div>
    </div>
    {{/if}}

    {{#if content}}
    <div class="prose">
      <div class="post-content">{{content}}</div>
    </div>
    {{/if}}
  </div>
</section>
{{/post}}
