{{!< default}}
{{!-- Membresía $350/mes: qué incluye + botón Stripe. --}}

{{#post}}
<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / {{title}}</p>
    <div class="section-head">
      <span class="s-eyebrow">Membresía · $350 MXN al mes</span>
      <h1 class="s-title">{{title}}</h1>
      {{#if custom_excerpt}}
        <p class="s-desc">{{custom_excerpt}}</p>
      {{/if}}
    </div>

    <div class="callout" style="margin-bottom:2rem">
      <h3>El archivo sigue libre</h3>
      <p style="margin-top:0.75rem">La membresía da acceso a un espacio de trabajo para quien necesita información más especializada: bases de arquitecturas RAG soberanas, análisis de datos con criterio, protocolos para organizar conocimiento y defensa del territorio, y marcos de geopolítica del conocimiento aplicados a proyectos reales.</p>
      <p style="margin-top:0.75rem">Si defiendes activamente el territorio y no puedes pagar la membresía, <a href="{{@site.url}}/contacto/">escríbeme</a>.</p>
    </div>

    <div class="grid-2" style="margin-bottom:2rem;align-items:stretch">
      <div class="offer">
        <span class="offer-badge">Qué incluye</span>
        <h3>$350 MXN / mes</h3>
        <ul class="offer-bullets">
          <li>Espacio de trabajo con información más especializada</li>
          <li>Chat exclusivo de miembros (Matrix)</li>
          <li>Bases de arquitecturas RAG soberanas</li>
          <li>Análisis de datos con criterio</li>
          <li>Protocolos para organizar conocimiento y defensa del territorio</li>
          <li>Marcos de geopolítica del conocimiento para proyectos reales</li>
          <li>Comentarios en el sitio + acceso al chat general</li>
        </ul>
        {{#if @custom.membership_stripe_url}}
          <a class="btn btn-brand btn-full" style="margin-top:auto" href="{{@custom.membership_stripe_url}}" target="_blank" rel="noopener">Unirme · $350 MXN/mes</a>
        {{else}}
          <a class="btn btn-brand btn-full" style="margin-top:auto" href="#/portal/signup" data-portal="signup">Unirme</a>
        {{/if}}
      </div>
      <div class="offer">
        <span class="offer-badge outline">Sin membresía</span>
        <h3>Sigue libre</h3>
        <p class="offer-desc">El Archivo, las notas, videos, podcasts, documentos e información de talleres se leen sin pagar.</p>
        <ul class="offer-bullets">
          <li>Biblioteca pública</li>
          <li>Cuenta gratis para comentar y chat general</li>
          <li>Talleres: pago por producto (aparte)</li>
        </ul>
        <a class="btn btn-full" style="margin-top:auto" href="{{@site.url}}/archivo/">Ir al Archivo</a>
      </div>
    </div>

    {{#if @custom.membership_stripe_url}}
    <div class="cta-row" style="margin-bottom:2rem">
      <a class="btn btn-brand" href="{{@custom.membership_stripe_url}}" target="_blank" rel="noopener">Pagar membresía en Stripe · $350 MXN/mes</a>
    </div>
    {{/if}}

    {{#if @member.paid}}
      {{#if @custom.matrix_paid_room_url}}
      <div class="section-head">
        <span class="s-eyebrow">Tu sala de miembro</span>
        <h2 class="s-title">Chat exclusivo</h2>
      </div>
      <div class="chat" style="margin-bottom:2rem">
        <div class="chat-head"><span class="pulse" aria-hidden="true"></span><b>Chat exclusivo · membresía</b></div>
        <iframe src="{{@custom.matrix_paid_room_url}}" allow="microphone; camera; autoplay; clipboard-write; encrypted-media" title="Chat exclusivo de membresía" loading="lazy"></iframe>
      </div>
      {{/if}}
    {{/if}}

    {{#if @custom.donate_url}}
    <div class="callout" style="margin-bottom:2rem">
      <h3>Apoya el proyecto</h3>
      <p style="margin-top:0.5rem">Si no tomas la membresía pero quieres sostener el trabajo con dinero, aquí puedes apoyar el proyecto.</p>
      <div class="cta-row" style="margin-top:1rem">
        <a class="btn btn-brand" href="{{@custom.donate_url}}" target="_blank" rel="noopener">Apoya el proyecto</a>
      </div>
    </div>
    {{/if}}

    {{#if content}}
    <div class="prose">
      <div class="post-content">{{content}}</div>
    </div>
    {{/if}}
  </div>
</section>
{{/post}}
