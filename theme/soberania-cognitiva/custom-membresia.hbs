{{!< default}}
{{!-- Membresía ($350 MXN/mes): espacio de trabajo especializado.
     El archivo sigue libre. Apoya el proyecto = sostén opcional. --}}

{{#post}}
<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / {{title}}</p>
    <div class="section-head">
      <span class="s-eyebrow">Membresía · $350 MXN al mes</span>
      <h1 class="s-title">{{title}}</h1>
      {{#if custom_excerpt}}
        <p class="s-desc">{{custom_excerpt}}</p>
      {{/if}}
    </div>

    <div class="callout" style="margin-bottom:2rem">
      <h3>El archivo sigue libre</h3>
      <p style="margin-top:0.75rem">La membresía da acceso a un espacio de trabajo para quien necesita información más especializada: bases de arquitecturas RAG soberanas, análisis de datos con criterio, protocolos para organizar conocimiento y defensa del territorio, y marcos de geopolítica del conocimiento aplicados a proyectos reales.</p>
      <p style="margin-top:0.75rem">Si defiendes activamente el territorio y no puedes pagar la membresía, <a href="{{@site.url}}/contacto/">escríbeme</a>.</p>
      <p style="margin-top:0.75rem"><b>$350 MXN al mes.</b></p>
    </div>

    <div class="grid-3" style="margin-bottom:2rem">
      <div class="offer">
        <span class="offer-badge outline">Sin cuenta</span>
        <h3>Leer</h3>
        <p class="offer-desc">Análisis, archivo, video, podcast, documentos e info de talleres: libre.</p>
        <ul class="offer-bullets">
          <li>Biblioteca abierta</li>
          <li>Sin registro obligatorio</li>
          <li>Contacto seguro</li>
        </ul>
      </div>
      <div class="offer">
        <span class="offer-badge soft">Cuenta gratis</span>
        <h3>Participar</h3>
        <p class="offer-desc">El sitio ya es funcional: comentas y entras al chat general.</p>
        <ul class="offer-bullets">
          <li>Comentar en las notas</li>
          <li>Chat general (Matrix)</li>
          <li>Boletín</li>
        </ul>
        {{#unless @member}}
          <a class="btn btn-full" style="margin-top:auto" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
        {{else}}
          <a class="btn btn-full" style="margin-top:auto" href="#/portal/account" data-portal="account">Mi cuenta</a>
        {{/unless}}
      </div>
      <div class="offer">
        <span class="offer-badge">Membresía</span>
        <h3>Trabajar</h3>
        <p class="offer-desc">Espacio de trabajo especializado + chat exclusivo. Las bases de lo que yo hago, aplicadas a tu proyecto.</p>
        <ul class="offer-bullets">
          <li>Todo lo de cuenta gratis</li>
          <li>Chat exclusivo de miembros</li>
          <li>Información más especializada</li>
        </ul>
      </div>
    </div>

    {{#get "tiers" include="monthly_price,yearly_price,currency" limit="all" as |tiers|}}
      {{#if tiers}}
      <div class="section-head">
        <span class="s-eyebrow">Cómo unirte</span>
        <h2 class="s-title">Cuenta gratis o membresía</h2>
      </div>
      <div class="offer-grid" style="margin-bottom:2rem">
        {{#foreach tiers}}
          <article class="offer">
            <span class="offer-badge">{{#if monthly_price}}Pago{{else}}Gratis{{/if}}</span>
            <h3>{{name}}</h3>
            {{#if description}}<p class="offer-desc">{{description}}</p>{{/if}}
            {{#if monthly_price}}
              <p class="offer-price">{{price monthly_price currency=currency}} <span>· al mes</span></p>
              {{#if yearly_price}}<p class="offer-meta">o {{price yearly_price currency=currency}} al año</p>{{/if}}
              {{#if @member.paid}}
                <a class="btn btn-brand btn-full" href="#/portal/account" data-portal="account">Ya eres miembro · Mi cuenta</a>
              {{else}}
                <a class="btn btn-brand btn-full" href="#/portal/signup/{{id}}/monthly" data-portal="signup/{{id}}/monthly">Hacerme miembro · {{price monthly_price currency=currency}}/mes</a>
              {{/if}}
            {{else}}
              <p class="offer-meta">Cuenta gratis · chat general + comentarios</p>
              {{#unless @member}}
                <a class="btn btn-full" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
              {{else}}
                <a class="btn btn-full" href="#/portal/account" data-portal="account">Mi cuenta</a>
              {{/unless}}
            {{/if}}
          </article>
        {{/foreach}}
      </div>
      {{else}}
      <div class="callout" style="margin-bottom:2rem">
        <h3>Configura los tiers en Ghost</h3>
        <p style="margin-top:0.5rem">Settings → Membership: tier <b>Free</b> + tier de pago <b>Membresía · $350 MXN / mes</b> con Stripe.</p>
        <div class="cta-row" style="margin-top:1rem">
          <a class="btn btn-brand" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
        </div>
      </div>
      {{/if}}
    {{/get}}

    {{#if @member.paid}}
      {{#if @custom.matrix_paid_room_url}}
      <div class="section-head">
        <span class="s-eyebrow">Tu sala de miembro</span>
        <h2 class="s-title">Chat exclusivo</h2>
      </div>
      <div class="chat" style="margin-bottom:2rem">
        <div class="chat-head"><span class="pulse" aria-hidden="true"></span><b>Chat exclusivo · membresía</b></div>
        <iframe src="{{@custom.matrix_paid_room_url}}" allow="microphone; camera; autoplay; clipboard-write; encrypted-media" title="Chat exclusivo de membresía" loading="lazy"></iframe>
      </div>
      {{/if}}
    {{/if}}

    {{#if @custom.donate_url}}
    <div class="callout" style="margin-bottom:2rem">
      <h3>Apoya el proyecto</h3>
      <p style="margin-top:0.5rem">Si no tomas la membresía pero quieres sostener el trabajo con dinero, aquí puedes apoyar el proyecto.</p>
      <div class="cta-row" style="margin-top:1rem">
        <a class="btn btn-brand" href="{{@custom.donate_url}}" target="_blank" rel="noopener">Apoya el proyecto</a>
      </div>
    </div>
    {{/if}}

    {{#if content}}
    <div class="prose">
      <div class="post-content">{{content}}</div>
    </div>
    {{/if}}
  </div>
</section>
{{/post}}
