{{!< default}}

<section class="section">
  <div class="container prose" style="text-align:center">
    <span class="eyebrow">Error {{statusCode}}</span>
    <h1 style="font-size:clamp(2rem,6vw,3rem);margin:0.5rem 0 1rem">{{message}}</h1>
    <p>La página que buscas no está aquí. Quizá se movió, o el enlace no es correcto.</p>
    <div class="cta-row" style="justify-content:center">
      <a class="btn btn-brand" href="{{@site.url}}/">Volver al inicio</a>
    </div>
  </div>
</section>
