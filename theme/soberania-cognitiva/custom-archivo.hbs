{{!< default}}
{{!-- Plantilla: El archivo de lo improbable. Asígnala a tu página "Archivo".
     Etiqueta tus publicaciones con: nota, video, podcast o pdf para que aparezcan
     automáticamente en cada bloque. --}}

{{#post}}
<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / {{title}}</p>
    <div class="section-head">
      <span class="s-eyebrow">Archivo</span>
      <h1 class="s-title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="s-desc">{{custom_excerpt}}</p>{{/if}}
    </div>
    {{#if content}}<div class="prose" style="margin:0 0 1.5rem"><div class="post-content">{{content}}</div></div>{{/if}}
  </div>
</section>
{{/post}}

{{!-- NOTAS & POSTS --}}
{{#get "posts" filter="tag:nota" limit="6" as |items|}}
  {{#if items}}
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head"><span class="s-eyebrow">01</span><h2 class="s-title">Notas &amp; posts</h2></div>
      <div class="card-grid">{{#foreach items}}{{> post-card}}{{/foreach}}</div>
    </div>
  </section>
  {{/if}}
{{/get}}

{{!-- VIDEO --}}
{{#get "posts" filter="tag:video" limit="4" as |items|}}
  {{#if items}}
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head"><span class="s-eyebrow">02</span><h2 class="s-title">Video</h2>
        <p class="s-desc">La portada te lleva a la publicación con el video embebido o al enlace de la plataforma.</p></div>
      <div class="media-grid">
        {{#foreach items}}
        <a class="media" href="{{url}}" aria-label="Ver: {{title}}">
          {{#if feature_image}}<img src="{{img_url feature_image size="m"}}" alt="{{title}}">{{/if}}
          <span class="play"><span><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span></span>
          <span class="caption">{{#primary_tag}}<span class="k">{{name}}</span>{{/primary_tag}}<span class="t">{{title}}</span></span>
        </a>
        {{/foreach}}
      </div>
    </div>
  </section>
  {{/if}}
{{/get}}

{{!-- PODCAST --}}
{{#get "posts" filter="tag:podcast" limit="6" as |items|}}
  {{#if items}}
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head"><span class="s-eyebrow">03</span><h2 class="s-title">Podcast</h2>
        <p class="s-desc">Donde hablo más despacio, más específico y más íntimo. Más yo.</p></div>
      <div class="doc-list">
        {{#foreach items}}
        <a class="doc" href="{{url}}">
          <span class="doc-kind">ep.</span>
          <span class="doc-body"><span class="doc-title">{{title}}</span><span class="doc-desc">{{reading_time}} · {{date format="D MMM YYYY"}}</span></span>
          <span class="doc-arrow">&#9654;</span>
        </a>
        {{/foreach}}
      </div>
    </div>
  </section>
  {{/if}}
{{/get}}

{{!-- PDFs & DOCUMENTOS --}}
{{#get "posts" filter="tag:pdf" limit="8" as |items|}}
  {{#if items}}
  <section class="section" style="padding-top:0">
    <div class="container">
      <div class="section-head"><span class="s-eyebrow">04</span><h2 class="s-title">PDFs &amp; documentos</h2></div>
      <div class="doc-list">
        {{#foreach items}}
        <a class="doc" href="{{url}}">
          <span class="doc-kind">PDF</span>
          <span class="doc-body"><span class="doc-title">{{title}}</span><span class="doc-desc">{{date format="D MMM YYYY"}}</span></span>
          <span class="doc-arrow">&#8595;</span>
        </a>
        {{/foreach}}
      </div>
    </div>
  </section>
  {{/if}}
{{/get}}
