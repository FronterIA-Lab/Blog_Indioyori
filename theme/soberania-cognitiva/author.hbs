{{!< default}}

{{#author}}
<section class="section" style="padding-bottom:0.5rem">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / Autoría</p>
    <div class="section-head">
      <span class="s-eyebrow">Autoría</span>
      <h1 class="s-title">{{name}}</h1>
      {{#if bio}}<p class="s-desc">{{bio}}</p>{{/if}}
    </div>
  </div>
</section>
{{/author}}

<section class="section" style="padding-top:0.5rem">
  <div class="container">
    {{#if posts}}
    <div class="card-grid">
      {{#foreach posts}}
        {{> post-card}}
      {{/foreach}}
    </div>
    {{else}}
    <p class="note">Aún no hay publicaciones de esta autoría.</p>
    {{/if}}
  </div>
</section>

<section class="pagination">
  <div class="container">
    {{pagination}}
  </div>
</section>
