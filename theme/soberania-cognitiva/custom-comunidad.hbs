{{!< default}}
{{!-- Plantilla: Comunidad.
     - Sin cuenta: puede leer el sitio; aquí ve CTA para registrarse.
     - Cuenta gratis: chat general + comentar.
     - Pago: lo mismo + chat exclusivo.
--}}

{{#post}}
<section class="section">
  <div class="container">
    <p class="breadcrumb"><a href="{{@site.url}}/">Inicio</a> / {{title}}</p>
    <div class="section-head">
      <span class="s-eyebrow">Comunidad · cercanía con criterio</span>
      <h1 class="s-title">{{title}}</h1>
      {{#if custom_excerpt}}<p class="s-desc">{{custom_excerpt}}</p>{{/if}}
    </div>

    <div class="grid-3" style="margin-bottom:2rem">
      <div class="offer">
        <span class="offer-badge outline">Sin cuenta</span>
        <h3>Visitar</h3>
        <ul class="offer-bullets">
          <li>Leer todo lo publicado</li>
          <li>Ver talleres e inscribirse</li>
          <li>Usar Contacto seguro</li>
        </ul>
      </div>
      <div class="offer">
        <span class="offer-badge soft">Cuenta gratis</span>
        <h3>Participar</h3>
        <ul class="offer-bullets">
          <li>Comentar en las notas</li>
          <li>Entrar al chat general</li>
          <li>Recibir el boletín</li>
        </ul>
      </div>
      <div class="offer">
        <span class="offer-badge">Círculo de pago</span>
        <h3>Profundizar</h3>
        <ul class="offer-bullets">
          <li>Todo lo de cuenta gratis</li>
          <li>Chat exclusivo</li>
          <li>Recursos más avanzados</li>
        </ul>
        <a class="btn btn-brand" style="margin-top:0.75rem" href="{{@site.url}}/membresia/">Ver membresía</a>
      </div>
    </div>

    {{!-- --- Visitante sin cuenta --- --}}
    {{#unless @member}}
      <div class="callout" style="margin-bottom:1.5rem">
        <h3>Entra con cuenta gratis</h3>
        <p style="margin-top:0.5rem">El sitio se lee sin registrarte. Para comentar y usar el <b>chat general</b>, crea una cuenta gratis. Si más adelante quieres el círculo exclusivo, lo activas desde Membresía.</p>
        <div class="cta-row" style="margin-top:1rem">
          <a class="btn btn-brand" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
          <a class="btn" href="#/portal/signin" data-portal="signin">Ya tengo cuenta · Entrar</a>
        </div>
      </div>
    {{/unless}}

    {{!-- --- Chat general: cualquier miembro (gratis o de pago) --- --}}
    {{#if @member}}
      {{#if @custom.matrix_room_url}}
      <div class="chat" style="margin-bottom:1.5rem">
        <div class="chat-head"><span class="pulse" aria-hidden="true"></span><b>Chat general · comunidad</b></div>
        <iframe src="{{@custom.matrix_room_url}}" allow="microphone; camera; autoplay; clipboard-write; encrypted-media" title="Chat general · comunidad" loading="lazy"></iframe>
      </div>
      <p class="note" style="margin-bottom:2rem">
        Sala general para quienes tienen cuenta (gratis o de pago).
        {{#if @custom.matrix_user}} Coordinación: <code>{{@custom.matrix_user}}</code>.{{/if}}
        Si el iframe no carga, ábrela en <a href="https://app.element.io" target="_blank" rel="noopener">Element</a>.
      </p>
      {{/if}}

      {{!-- --- Chat exclusivo: solo pago --- --}}
      {{#if @member.paid}}
        {{#if @custom.matrix_paid_room_url}}
        <div class="section-head">
          <span class="s-eyebrow">Círculo de pago</span>
          <h2 class="s-title">Chat exclusivo</h2>
          <p class="s-desc">Misma comunidad, capa más especializada: RAG, análisis, protocolos y materiales que no van al chat general.</p>
        </div>
        <div class="chat">
          <div class="chat-head"><span class="pulse" aria-hidden="true"></span><b>Chat exclusivo · miembros de pago</b></div>
          <iframe src="{{@custom.matrix_paid_room_url}}" allow="microphone; camera; autoplay; clipboard-write; encrypted-media" title="Chat exclusivo · miembros de pago" loading="lazy"></iframe>
        </div>
        {{else}}
        <div class="note">Falta configurar <code>matrix_paid_room_url</code> en Design → Customize (URL de la sala exclusiva en Element).</div>
        {{/if}}
      {{else}}
        <div class="callout">
          <h3>¿Quieres el chat exclusivo?</h3>
          <p style="margin-top:0.5rem">Con tu cuenta gratis ya puedes comentar y usar el chat general. El círculo de pago suma la sala exclusiva y recursos más avanzados — sin quitarte lo que ya tienes.</p>
          <div class="cta-row" style="margin-top:1rem">
            <a class="btn btn-brand" href="{{@site.url}}/membresia/">Ver membresía de pago</a>
          </div>
        </div>
      {{/if}}
    {{/if}}

    {{#if content}}
    <div class="prose" style="margin-top:2rem">
      <div class="post-content">{{content}}</div>
    </div>
    {{/if}}
  </div>
</section>

<section class="band">
  <div class="container section">
    <div class="grid-2 narrow-right" style="align-items:center">
      <div>
        <span class="s-eyebrow">Cuenta gratis</span>
        <h2 class="s-title">El sitio funciona sin pagar.</h2>
        <p class="s-desc">Regístrate para comentar y entrar al chat general. El pago es opcional: solo si quieres la capa exclusiva.</p>
        <div class="cta-row" style="margin-top:1.25rem">
          {{#unless @member}}
          <a class="btn btn-brand" href="#/portal/signup" data-portal="signup">Crear cuenta gratis</a>
          {{else}}
          <a class="btn btn-brand" href="#/portal/account" data-portal="account">Mi cuenta</a>
          {{/unless}}
          <a class="btn btn-ghost" style="color:#fff;border-color:#3a3a3a" href="{{@site.url}}/membresia/">Círculo de pago</a>
        </div>
      </div>
      <div class="callout">
        <h3>Gratis + opcional</h3>
        <p style="font-size:0.9rem;margin-top:0.5rem">No es un muro. Es la misma casa: una sala abierta a quien se inscribe, y otra más íntima para quien sostiene el trabajo con la membresía.</p>
      </div>
    </div>
  </div>
</section>
{{/post}}
