<!-- Customizing -->
<div data-customize x-data="{ customize: false }" x-init="setTimeout(function (){ document.querySelector('[data-customize]').classList.remove('hidden') }, 2000)" class="hidden fixed w-full flex flex-wrap gap-4 font-system text-sm right-8 bottom-8 z-100" style="max-width: 260px;">
  <div class="bg-bgr-tone text-typ flex flex-col gap-3 basis-full border border-brd px-4 py-4 rounded-theme" :class="customize ? 'opacity-100' : 'hidden'">
    <!-- Brand color -->
    <label class="flex flex-col gap-1">
      <span class="text-xs uppercase font-semibold opacity-50">Brand color</span>
      <input class="w-full rounded-cust" style="background:transparent;padding:0;" id="brand-color" type="color" value="#87ceeb" data-prop="--ghost-accent-color" 
        oninput="document.documentElement.style.setProperty(event.target.getAttribute('data-prop'), value);document.documentElement.style.setProperty('--color-brand-contrast', getColorContrast(value));setBrandHSL(value)"/>
    </label>

    <!-- Background color -->
    <label class="flex flex-col gap-1">
      <span class="text-xs uppercase font-semibold opacity-50">Background color</span>
      <input class="border w-full rounded-cust" style="background:transparent;padding:0;" id="background-color" type="color" value="#FFFFFF" data-prop="--color-background" 
        oninput="document.documentElement.style.setProperty(event.target.getAttribute('data-prop'), value);"/>
    </label>
    
    <!-- Text color -->
    <label class="flex flex-col gap-1">
      <span class="text-xs uppercase font-semibold opacity-50">Text color</span>
      <input class="w-full rounded-cust" style="background:transparent;padding:0;" id="text-color" type="color" value="#262626" data-prop="--color-typography" 
        oninput="document.documentElement.style.setProperty(event.target.getAttribute('data-prop'), value);"/>
    </label>

    <!-- Border color -->
    <label class="flex flex-col gap-1">
      <span class="text-xs uppercase font-semibold opacity-50">Border color</span>
      <input class="w-full rounded-cust" style="background:transparent;padding:0;" id="border-color" type="color" value="#E6E6E6" data-prop="--color-border" 
        oninput="document.documentElement.style.setProperty(event.target.getAttribute('data-prop'), value);"/>
    </label>
    
    <!-- Font headings -->
    <label class="flex flex-col gap-1">
      <span class="text-xs uppercase font-semibold opacity-50">Font headings</span>
      <select class="text-typ bg-bgr text-sm p-1 px-2 border border-brd rounded-cust" name="font-headings" id="font-headings" 
        data-template="https://fonts.googleapis.com/css2?family={font_name}:wght@400;500;600;700;800&display=swap"
        onchange="if(this.options[this.selectedIndex].value === 'System') {
            document.body.style.setProperty('--font-headings', 'var(--font-system)') 
        } else {
            document.body.style.setProperty('--font-headings', `'${this.options[this.selectedIndex].text}'`);
            let googleFont = document.createElement('link');
            googleFont.id=this.options[this.selectedIndex].value;
            googleFont.rel='stylesheet';
            googleFont.href=this.getAttribute('data-template').replace('{font_name}', this.options[this.selectedIndex].text);
            document.head.appendChild(googleFont)
        }"
      >
        <option value="Cinzel">Cinzel</option>
        <option value="Heebo">Heebo</option>
        <option value="Inter">Inter</option>
        <option value="Instrument Sans">Instrument Sans</option>
        <option value="Instrument Serif">Instrument Serif</option>
        <option value="Orbit">Orbit</option>
        <option value="Plus Jakarta Sans">Plus Jakarta Sans</option>
        <option value="Prata">Prata</option>
        <option value="Space Mono" selected>Space Mono</option>
        <option value="Sulphur Point">Sulphur Point</option>
        <option value="System">System</option>
      </select>
    </label>

    <!-- Font body -->
    <label class="flex flex-col gap-1">
      <span class="text-xs uppercase font-semibold opacity-50">Font body</span>
      <select class="text-typ bg-bgr text-sm p-1 px-2 border border-brd rounded-cust" name="font-body" id="font-body" 
        data-template="https://fonts.googleapis.com/css2?family={font_name}:wght@400;500;600;700;800&display=swap"
        onchange="if(this.options[this.selectedIndex].value === 'System') {
            document.body.style.setProperty('--font-body', 'var(--font-system)')
        } else {
            document.body.style.setProperty('--font-body', `'${this.options[this.selectedIndex].text}'`);
            let googleFont = document.createElement('link');
            googleFont.id=this.options[this.selectedIndex].value;
            googleFont.rel='stylesheet';
            googleFont.href=this.getAttribute('data-template').replace('{font_name}', this.options[this.selectedIndex].text);
            document.head.appendChild(googleFont);
        }"
      >
        <option value="Cinzel">Cinzel</option>
        <option value="Heebo">Heebo</option>
        <option value="Inter">Inter</option>
        <option value="Instrument Sans">Instrument Sans</option>
        <option value="Instrument Serif">Instrument Serif</option>
